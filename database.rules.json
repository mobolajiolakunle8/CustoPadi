{
  "rules": {
    "businesses": {
      "$uid": {
        ".read": "auth !== null && (auth.uid === $uid || root.child('staffIndex').child(auth.uid).child('ownerUid').val() === $uid)",
        ".write": "auth !== null && (auth.uid === $uid || root.child('staffIndex').child(auth.uid).child('ownerUid').val() === $uid)",
        "staff": {
          "$staffUid": {
            ".write": "auth !== null && auth.uid === $uid"
          }
        },
        "customers": {
          "$cid": {
            ".read": "auth !== null && (auth.uid === $uid || root.child('staffIndex').child(auth.uid).child('ownerUid').val() === $uid)",
            ".write": "auth !== null && (auth.uid === $uid || root.child('staffIndex').child(auth.uid).child('ownerUid').val() === $uid)"
          }
        }
      }
    },
    "usersByPhone": {
      "$phone": {
        ".read": "auth !== null",
        ".write": "newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChild('uid')"
      }
    },
    "staffIndex": {
      "$staffUid": {
        ".read": "auth !== null && (auth.uid === $staffUid || root.child('staffIndex').child(auth.uid).child('role').val() === 'owner')",
        ".write": "newData.child('ownerUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['ownerUid', 'role']) && newData.child('role').val() === 'staff'"
      }
    },
    "recovery": {
      "$phone": {
        ".read": true,
        ".write": "auth !== null && $phone.matches(/^[1-9][0-9]{6,14}$/) && auth.token.email === $phone + '@phone.custopadi.app'",
        ".validate": "newData.hasChildren(['v', 's', 'i', 'b'])",
        "v": { ".validate": "newData.val() === 1" },
        "s": { ".validate": "newData.isString() && newData.val().length < 60" },
        "i": { ".validate": "newData.isString() && newData.val().length < 40" },
        "b": { ".validate": "newData.isString() && newData.val().length < 8000" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
