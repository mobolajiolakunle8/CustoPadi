rules_version = '2';

// CustoPadi security rules.
// Each business can only read and change its own records. Nobody else can see them.
// A business logs in as <whatsapp number>@custopadi.firebaseapp.com (the app does this
// behind the scenes). If you change LOGIN_DOMAIN in index.html, change it here too.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(phone) {
      return request.auth != null
        && request.auth.token.email == phone + '@custopadi.firebaseapp.com';
    }

    match /businesses/{phone} {
      allow read, write: if isOwner(phone);

      match /customers/{customerId} {
        allow read, write: if isOwner(phone);
      }
    }
  }
}
